# Copy to .env before first use.

# Docker image
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_SHM_SIZE=16gb

# Optional Hugging Face token. Public Qwen models can usually download without it,
# but having a token helps avoid rate limits.
HF_TOKEN=

# 4B service: recommended on the 3080 box
QWEN_4B_MODEL=Qwen/Qwen3.5-4B
QWEN_4B_SERVED_NAME=qwen3.5-4b-local
QWEN_4B_PORT=8014
QWEN_4B_GPU=0
QWEN_4B_DTYPE=half
QWEN_4B_MAX_LEN=1024
QWEN_4B_GPU_MEM_UTIL=0.72
QWEN_4B_MAX_NUM_SEQS=1

# 9B service: recommended on the 4090 box
QWEN_9B_MODEL=Qwen/Qwen3.5-9B
QWEN_9B_SERVED_NAME=qwen3.5-9b-local
QWEN_9B_PORT=8019
QWEN_9B_GPU=1
QWEN_9B_DTYPE=half
QWEN_9B_MAX_LEN=4096
QWEN_9B_GPU_MEM_UTIL=0.94
QWEN_9B_MAX_NUM_SEQS=1

# If you later want to test a future official Qwen3.6 open-weight release,
# only change the MODEL values above. The rest of the subproject can stay the same.
# Conservative 3080 profile can also rely on CPU offload.
QWEN_4B_CPU_OFFLOAD_GB=4
